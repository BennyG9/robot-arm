function valid = verify_time_func(Q, dt, robot)

    dT = ones(1, size(Q, 3));
    if(isscalar(dt))
        dT = dt * dT;
    else
        dT = dt;
    end
    
    DQ = diff(Q, 1, 3);
    DQ = Q ./ dT;
    DQ_max = [robot.base.max_speed; robot.shoulder.max_speed; robot.elbow.max_speed];

    valid = all((DQ ./ DQ_max) <= 1, 'all');
end