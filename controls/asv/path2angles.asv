function Q = path2angles(path, robot)
    all_angles = zeros(3,4,size(path,2));
    path_index = 0;

    % iterate through each position in the path
    last_valid_angles = zeros(3,4);
    for pos = path
        path_index = path_index + 1;

        [q, valid] = inverse_kinematics(pos, robot);

        % unable to calculate angles
        if(~valid)
            all_angles(1:3, 1:4, path_index) = zeros(3, 4);
            continue;
        end

        % first point in path
        if(path_index == 1)
            all_angles(1:3, 1:4, 1) = q;
            last_valid_angles(:,:) = q;
            continue;
        end

        % insert rest of angles based on continuity
        for i = 1:4
            min_norm = Inf;
            for qi = q
                current_norm = zeros(3);

                if(all(all_angles(1:3, i, path_index-1) == 0))
                    current_norm(1:3) = norm(qi - last_valid_angles(1:3,i));
                else
                    current_norm = norm(qi - all_angles(1:3, i, path_index-1));
                end

                if(current_norm < min_norm)
                    min_norm = current_norm;
                    all_angles(1:3, i, path_index) = qi;
                end
            end
        end
        last_valid_angles(:,:) = q;

    end

    Q = all_angles(:, :, :);

    % replace sequences of invalid angles
    for k = 1:4
        last_nonzero_angles = zeros(3);
        last_nonzero_index = 0;
        invalid_angles = 0;
        for i = 1:size(Q,3)
            qki = Q(:,k,i);

            if(all(qki == 0))
                invalid_angles = invalid_angles + 1;
                continue;
            end

            valid = verify_angles(qki, robot);
            if(~valid)
                invalid_angles = invalid_angles + 1;
                Q(:,k,i) = clamp_angles(qki, robot);
            end

            if(last_nonzero_index ~= 0 && last_nonzero_index )

            end

            last_nonzero_angles(:) = Q(:,k,i);
            last_nonzero_index = i;
        end
    end
end