function animate_path(mode, path, robot)
    arguments
        mode (1,1) string {mustBeMember(mode, ["coords", "angles"])}
        path (3,:) double
        robot (1,1) struct
    end

    trace = [];

    switch mode
        case "coords"
            for r = path

                if(~verify_position(r, robot))
                    disp("INVALID POSE");
                    continue;
                end

                Q = inverse_kinematics(r, robot);
                q = 

                T = forward_kinematics(q, robot);

                plot_robot(T);
                
                trace = [trace, T(1:3,4,5)];
                hold on;
                plot3(trace(1,:), trace(2,:), trace(3,:), "LineWidth", 2);
                hold off;

                pause(0.01);
            end

        case "angles"
            for q = path
                T = forward_kinematics(q, robot);
                
                plot_robot(T);

                trace = [trace, T(1:3,4,5)];
                hold on;
                plot3(trace(1,:), trace(2,:), trace(3,:), "LineWidth", 2);
                hold off;

                pause(0.01);
            end
    end
end